{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MindPipe",
  "version": "0.1.0",
  "identifier": "com.mindpipe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MindPipe",
        "url": "index.html",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420,
        "visible": true,
        "center": true
      },
      {
        "label": "capture",
        "title": "MindPipe Capture",
        "url": "capture.html",
        "width": 480,
        "height": 220,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/projects/**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
